# Template only. Do not put real hashes in this file.
#
# Create the real file OUTSIDE the web root where you can:
#
#     htpasswd -c /path/to/.htpasswd yourname        (Apache utils; prompts for a password)
#     php -r "echo 'yourname:' . password_hash('CHANGE-ME', PASSWORD_BCRYPT) . PHP_EOL;" > /path/to/.htpasswd
#
# then point AuthUserFile in .htaccess at the absolute path of that file.
# Lines starting with # are ignored by Apache. One "user:hash" entry per line:
#
# yourname:$2y$10$replaceThisWithARealBcryptHashFromTheCommandAbove
